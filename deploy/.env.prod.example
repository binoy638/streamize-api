# Production environment for deploy/docker-compose.prod.yml.
# Copy to `.env` on the VPS (at /opt/streamize/.env) and fill in real values.
# Never commit the real .env - it holds secrets.

# Domain Traefik routes to this app and provisions TLS for.
DOMAIN=streamize.example.com

# Docker network the existing Traefik instance is attached to.
TRAEFIK_NETWORK=traefik_default

STREAMIZE_ENV=production
STREAMIZE_HTTP_ADDR=:8080
STREAMIZE_DATABASE_PATH=/data/streamize.db
STREAMIZE_MEDIA_ROOT=/media

STREAMIZE_QBITTORRENT_URL=http://qbittorrent:8081
STREAMIZE_QBITTORRENT_USERNAME=admin
# CHANGE ME - set a strong password (also set it in the qBittorrent WebUI).
STREAMIZE_QBITTORRENT_PASSWORD=change-me-qbittorrent-password

STREAMIZE_SESSION_COOKIE_NAME=streamize_session
STREAMIZE_SESSION_TTL=168h

STREAMIZE_ADMIN_USERNAME=admin
# CHANGE ME - set a strong admin password before first start.
STREAMIZE_ADMIN_PASSWORD=change-me-admin-password
STREAMIZE_ADMIN_STORAGE_QUOTA_BYTES=0

# Served over HTTPS via Traefik - keep these true in production.
STREAMIZE_SECURE_COOKIES=true
STREAMIZE_TRUSTED_PROXY_HEADERS=true

STREAMIZE_LOG_LEVEL=info
STREAMIZE_LOG_FORMAT=json

STREAMIZE_WORKER_ENABLED=true
STREAMIZE_WORKER_POLL_INTERVAL=5s
STREAMIZE_FFMPEG_PATH=ffmpeg
STREAMIZE_FFPROBE_PATH=ffprobe
STREAMIZE_TMDB_API_KEY=
STREAMIZE_METADATA_LANGUAGE=en-US

# uid/gid both containers run as - set to the deploy user's own ids
# (run `id` on the VPS). Cloud Ubuntu images often default the user to 1001.
PUID=1000
PGID=1000
TZ=Asia/Kolkata
QBITTORRENT_WEBUI_PORT=8081

# Host paths - relative to /opt/streamize where the compose file lives.
STREAMIZE_HOST_DATA_DIR=./data
STREAMIZE_HOST_MEDIA_DIR=./media
QBITTORRENT_HOST_CONFIG_DIR=./data/qbittorrent-config
